    <script>
        // Função apenas para simular os sensores mudando de valor na tela de forma inteligente
        function simularVariacao() {
            // Gera valores aleatórios realistas
            const novaTemp = (22 + Math.random() * 12).toFixed(1);
            const novaUmiAr = Math.floor(40 + Math.random() * 45);
            const novaUmiSolo = Math.floor(20 + Math.random() * 70);

            // Atualiza os elementos na tela
            document.getElementById('temp-val').innerText = novaTemp + '°C';
            document.getElementById('umi-ar-val').innerText = novaUmiAr + '%';
            document.getElementById('solo-val').innerText = novaUmiSolo + '%';

            // Lógica visual de Alerta para o Solo e Bomba
            const soloStatus = document.getElementById('solo-status');
            const bombaVal = document.getElementById('bomba-val');
            const bombaStatus = document.getElementById('bomba-status');

            if (novaUmiSolo < 40) {
                // Solo Seco
                soloStatus.innerText = 'Crítico / Seco';
                soloStatus.className = 'status alert';
                
                bombaVal.innerText = 'LIGADA';
                bombaVal.style.color = '#d32f2f';
                bombaStatus.innerText = 'Corrigindo Umidade';
                bombaStatus.style.backgroundColor = '#ffcdd2';
                bombaStatus.style.color = '#d32f2f';
            } else {
                // Solo Saudável
                soloStatus.innerText = 'Úmido';
                soloStatus.className = 'status ok';

                bombaVal.innerText = 'DESLIGADA';
                bombaVal.style.color = '#0288d1';
                bombaStatus.innerText = 'Economizando Água';
                bombaStatus.style.backgroundColor = '#e1f5fe';
                bombaStatus.style.color = '#0288d1';
            }
        }
    </script>
